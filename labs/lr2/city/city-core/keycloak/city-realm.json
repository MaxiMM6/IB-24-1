{
  "realm": "city",
  "enabled": true,
  "displayName": "Цифровой город — Паспортный стол",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR"
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru",
    "en"
  ],
  "defaultLocale": "ru",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "житель",
        "description": "житель города"
      },
      {
        "name": "врач",
        "description": "врач больницы"
      },
      {
        "name": "пациент",
        "description": "пациент больницы"
      },
      {
        "name": "регистратура",
        "description": "сотрудник регистратуры"
      },
      {
        "name": "кассир",
        "description": "кассир банка"
      },
      {
        "name": "контролёр_банка",
        "description": "подтверждает крупные переводы"
      },
      {
        "name": "диспетчер",
        "description": "диспетчер энергосети"
      },
      {
        "name": "чиновник",
        "description": "сотрудник мэрии"
      },
      {
        "name": "аналитик_soc",
        "description": "аналитик центра мониторинга"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cityhall",
      "name": "Район «Мэрия»",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CLIENT_SECRET_CITYHALL}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://cityhall.city.localhost:8080/auth/callback"
      ],
      "webOrigins": [
        "http://cityhall.city.localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://cityhall.city.localhost:8080/*",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles → roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bank",
      "name": "Район «Банк»",
