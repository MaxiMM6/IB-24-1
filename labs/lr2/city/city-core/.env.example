# Скопируйте в .env: cp .env.example .env
# Это УЧЕБНЫЕ значения. Перед заморозкой снимка (пара 8) замените их на свои.

# Пароль администратора Паспортного стола (Keycloak): http://auth.city.localhost:8080/admin
KC_ADMIN_PASSWORD=admin-change-me

# Пароль всех тестовых пользователей города (ivanov, petrova, doctor, ...)
CITY_TEST_PASSWORD=REDACTED

# Секреты клиентов районов. Каждый должен совпадать с OIDC_CLIENT_SECRET в .env района.
CLIENT_SECRET_CITYHALL=cityhall-dev-secret-change-me
CLIENT_SECRET_BANK=bank-dev-secret-change-me
CLIENT_SECRET_HOSPITAL=hospital-dev-secret-change-me
CLIENT_SECRET_GRID=grid-dev-secret-change-me
CLIENT_SECRET_SOC=REDACTED

# Токен Транспорта (NATS). Должен совпадать с NATS_TOKEN в .env районов.
NATS_TOKEN=REDACTED
