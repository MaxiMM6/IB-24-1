# Скопируйте в .env: cp .env.example .env — и замените SECRET_KEY.
# Сгенерировать ключ: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-меня

# Адрес района в браузере (через Шлюз)
PUBLIC_URL=http://bank.city.localhost:8080

# Паспортный стол (единый вход). Секрет должен совпадать с CLIENT_SECRET_BANK в .env ядра.
OIDC_ISSUER=http://auth.city.localhost:8080/realms/city
OIDC_CLIENT_ID=bank
OIDC_CLIENT_SECRET=bank-dev-secret-change-me

# Транспорт (шина событий). Токен должен совпадать с NATS_TOKEN в .env ядра.
NATS_URL=nats://nats:4222
NATS_TOKEN=REDACTED
